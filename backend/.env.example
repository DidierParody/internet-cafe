# Copia este archivo a backend/.env (ignorado por git) y completa los valores.
# Genera llaves con: uv run python -m app.keys

# Owner de Neon (DDL). SOLO local o CI para migrar; nunca en Render. Usa el host directo (sin "-pooler").
DATABASE_URL_MIGRATIONS=postgresql://neondb_owner:<password>@<host-directo>.neon.tech/neondb?sslmode=require&channel_binding=require
# Contraseña del rol svc_app (para `python -m app.db_admin bootstrap-role`).
APP_DB_PASSWORD=<aleatoria-32+>

# Runtime de la API: rol svc_app vía el endpoint "-pooler".
DATABASE_URL=postgresql://svc_app:<APP_DB_PASSWORD>@<host>-pooler.neon.tech/neondb?sslmode=require

# Llaves en base64 (32 bytes) y llave privada EC P-256 (PEM en base64).
# Deben ser las mismas en todos los entornos que compartan la base: si cambian, los datos cifrados no se leen.
DATA_ENC_KEY=
BLIND_INDEX_KEY=
JWT_PRIVATE_KEY_B64=

# URL pública del frontend: base del QR y origen permitido para la cookie de refresh.
FRONTEND_BASE_URL=http://localhost:5173
# Dominios de correo permitidos en el registro, separados por coma (vacío = cualquiera).
ALLOWED_EMAIL_DOMAINS=
